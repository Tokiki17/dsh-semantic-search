{
  "name": "@tokiki/dsh-semantic-search",
  "version": "0.2.0",
  "description": "Semantic Search for DeepSeek Harness: hybrid keyword + embedding search with reranking over your workspace and document folders. Works with no model, local Qwen3 GGUF models the plugin downloads and runs, Alibaba Cloud Model Studio, SiliconFlow, or any OpenAI-compatible service.",
  "license": "MIT",
  "type": "module",
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tokiki17/dsh-semantic-search.git"
  },
  "homepage": "https://github.com/Tokiki17/dsh-semantic-search#readme",
  "bugs": {
    "url": "https://github.com/Tokiki17/dsh-semantic-search/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "rag",
    "semantic-search",
    "embedding",
    "rerank",
    "qwen",
    "llama.cpp",
    "knowledge-base"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/client",
    "test": "node --test test/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-home-paths": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-home-paths": "0.2.1-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.5",
    "@deepseek-ai/dsh-plugin-market-index": "0.2.1-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "@types/react": "18.3.12",
    "esbuild": "0.28.2",
    "ignore": "7.0.14",
    "jszip": "3.10.2",
    "mammoth": "1.13.0",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "unpdf": "2.1.0",
    "zod": "4.4.3"
  }
}
